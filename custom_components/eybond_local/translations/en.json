      "no_inverter": "The collector connected, but the inverter behind it did not answer.",
      "unsupported_protocol": "The inverter reports an SMG-II protocol number this integration has not been measured on. Nothing would be decoded reliably.",
      "already_configured": "This collector address is already configured.",
      "prefix_in_use": "Another collector already uses this prefix. Entity ids are built from it, so each unit needs its own - for a three-phase bank, say inverter_l1, inverter_l2, inverter_l3.",
      "invalid_prefix": "Lower-case letters, digits and underscores, starting with a letter."
    },
