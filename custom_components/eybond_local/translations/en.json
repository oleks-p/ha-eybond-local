{
  "config": {
    "step": {
      "user": {
        "title": "EyeBond collector",
        "description": "Home Assistant will ask the collector to connect to it instead of its vendor cloud, then read the inverter behind it. Nothing is written to the inverter. Give the collector a DHCP reservation: announces go to this address.",
