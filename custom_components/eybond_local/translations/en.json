          "collector_ip": "Collector address",
          "advertise_ip": "Home Assistant's address on the collector's network",
          "port": "Port the collector connects to",
          "prefix": "Entity id prefix"
        }
      }
    },
    "error": {
      "port_in_use": "Something else is listening on this port - often another integration serving the same collector on 8899. Disable it first: only one integration can serve a collector.",
